# Copy this file to .env and fill in your real keys, OR just export these
# as environment variables directly in your terminal before running.

GROQ_API_KEY=your_groq_key_here
NEWSAPI_KEY=your_newsapi_key_here

# Optional — only needed if you want real email alerts sent automatically.
# EMAIL_FROM must be a Gmail address. EMAIL_PASSWORD is a 16-character
# Gmail "App Password" (NOT your normal Gmail password) — generate one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification on).
EMAIL_FROM=you@gmail.com
EMAIL_PASSWORD=your_16_char_app_password
EMAIL_TO=recipient@example.com
